# ZSYIO Global BMS - Backend Example Configuration
PORT=5000
NODE_ENV=development
APP_NAME=ZSYIO BMS
APP_VERSION=2.4.0-enterprise

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
OTP_EXPIRES_MINUTES=10

CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://frontend-five-psi-37.vercel.app

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX=15
